# Copy this file to .env and fill in real values. Never commit .env itself.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/llm_cost_optimizer

# Provider API keys - obtain from each provider's dashboard
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Auth
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# App
ENVIRONMENT=development
